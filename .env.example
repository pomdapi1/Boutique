# Base de données SQLite (chemin relatif au dossier prisma/)
DATABASE_URL="file:../data/conserve.db"

# Dossier de stockage des documents des créateurs
UPLOAD_DIR="./data/uploads"

# Secret de signature des sessions : chaîne aléatoire d'au moins 32 caractères
# (PowerShell : [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 })))
AUTH_SECRET="changez-moi-avec-une-longue-chaine-aleatoire-de-48-caracteres"

# Fuseau horaire utilisé pour les regroupements par jour / mois
TZ="Europe/Paris"

# --- SumUp ---
# mock : aucune connexion à SumUp (ventes simulées)
# live : synchronisation réelle avec l'API SumUp
SUMUP_MODE="mock"
SUMUP_API_KEY=""
SUMUP_MERCHANT_CODE=""
# Fréquence de synchronisation en mode live (secondes)
SUMUP_SYNC_INTERVAL_SECONDS="60"
# Profondeur d'import lors de la toute première synchronisation (jours)
SUMUP_INITIAL_DAYS="30"

# En mode mock : génère une vente aléatoire toutes les N secondes (0 = désactivé)
MOCK_AUTO_SALE_SECONDS="0"
